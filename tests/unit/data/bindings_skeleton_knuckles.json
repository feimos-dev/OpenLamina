{
  "controller_type": "knuckles",
  "bindings": {
    "/actions/main": {
      "sources": [
        { "path": "/user/hand/left/input/grip", "mode": "button", "inputs": { "click": { "output": "/actions/main/in/grab" } } },
        { "path": "/user/hand/right/input/grip", "mode": "button", "inputs": { "click": { "output": "/actions/main/in/grab" } } }
      ],
      "poses": [{ "output": "/actions/main/in/pose", "path": "/user/hand/right/pose/raw" }],
      "skeleton": [
        { "output": "/actions/main/in/skeleton_left", "path": "/user/hand/left/input/skeleton/left" },
        { "output": "/actions/main/in/skeleton_right", "path": "/user/hand/right/input/skeleton/right" }
      ]
    }
  }
}
